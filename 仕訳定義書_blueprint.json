{
  "hierarchy_structure": [
    {
      "level": 0,
      "name": "Meta_FileName",
      "regex": "(?m)^\\S.+\\.md$",
      "parent_level": null,
      "description": "先頭行にあるファイル名（例: 仕訳定義書.md）。本文構造ではなくメタ情報として扱う。",
      "validation_rules": {
        "max_length": 80,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": null,
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": 1,
        "max_line": 10,
        "prev_line_regex": null,
        "next_line_regex": null,
        "only_after_first_match_of": null,
        "context_filters": null
      }
    },
    {
      "level": 0,
      "name": "Meta_Date",
      "regex": "(?m)^\\d{4}-\\d{2}-\\d{2}$",
      "parent_level": null,
      "description": "改訂日などの日付行（例: 2025-10-27）。メタ情報。",
      "validation_rules": {
        "max_length": null,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": null,
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": 1,
        "max_line": 30,
        "prev_line_regex": null,
        "next_line_regex": null,
        "only_after_first_match_of": null,
        "context_filters": null
      }
    },
    {
      "level": 0,
      "name": "Meta_PageCounter",
      "regex": "(?m)^\\d+\\s*/\\s*\\d+$",
      "parent_level": null,
      "description": "ページカウンタ（例: 1 / 1）。解析時は除外推奨のメタ行。",
      "validation_rules": {
        "max_length": 20,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": null,
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": 1,
        "max_line": 30,
        "prev_line_regex": null,
        "next_line_regex": null,
        "only_after_first_match_of": null,
        "context_filters": null
      }
    },
    {
      "level": 0,
      "name": "Meta_DocumentTitleWithVersion",
      "regex": "(?m)^\\S.+\\sv\\d+(?:\\.\\d+)*$",
      "parent_level": null,
      "description": "文書タイトル＋バージョン（例: 仕訳定義書 v2.2）。メタ情報（ルートタイトル）として扱う。",
      "validation_rules": {
        "max_length": 120,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": null,
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": 1,
        "max_line": 50,
        "prev_line_regex": null,
        "next_line_regex": null,
        "only_after_first_match_of": null,
        "context_filters": null
      }
    },
    {
      "level": 1,
      "name": "Section",
      "regex": "(?m)^(\\d+)\\.\\s+(.+)$",
      "parent_level": null,
      "description": "最上位の番号見出し（例: 2. 仕訳生成ルール / 3. データ仕様 / 4. 例外処理）。",
      "validation_rules": {
        "max_length": 120,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。",
          "."
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "prev_line_regex": null,
        "next_line_regex": null,
        "only_after_first_match_of": "name:Meta_DocumentTitleWithVersion",
        "context_filters": null
      }
    },
    {
      "level": 2,
      "name": "Subsection",
      "regex": "(?m)^(\\d+)\\.(\\d+)\\.\\s+(.+)$",
      "parent_level": 1,
      "description": "第2階層の番号見出し（例: 2.1. 取引日付 / 2.2. 勘定科目 / 2.3. 金額 / 2.4. 摘要）。",
      "validation_rules": {
        "max_length": 120,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。",
          "."
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "prev_line_regex": null,
        "next_line_regex": null,
        "only_after_first_match_of": "level:1",
        "context_filters": null
      }
    }
  ],
  "global_exclusion_rules": {
    "exclude_page_counter_lines": {
      "regex": "(?m)^\\d+\\s*/\\s*\\d+$",
      "description": "ページ番号表記は構造解析から除外（ヘッダ/フッタ由来のノイズ）。"
    }
  }
}