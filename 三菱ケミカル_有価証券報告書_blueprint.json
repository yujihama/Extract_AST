{
  "hierarchy_structure": [
    {
      "level": 1,
      "name": "Part",
      "regex": "^第[一二三四五六七八九十百]+部【(?P<title>.+?)】$",
      "parent_level": null,
      "description": "最上位: 『第一部【企業情報】』等。",
      "validation_rules": {
        "max_length": 80,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。"
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "exclude_lines": null,
        "prev_line_regex": null,
        "next_line_regex": null,
        "only_after_first_match_of": null,
        "context_filters": null
      }
    },
    {
      "level": 2,
      "name": "Chapter",
      "regex": "^第(?P<num>[0-9０-９]+)【(?P<title>.+?)】$",
      "parent_level": 1,
      "description": "部の下位: 『第１【企業の概況】』等（数字は全角/半角）。",
      "validation_rules": {
        "max_length": 80,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。"
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "exclude_lines": null,
        "prev_line_regex": null,
        "next_line_regex": null,
        "only_after_first_match_of": null,
        "context_filters": null
      }
    },
    {
      "level": 3,
      "name": "Section",
      "regex": "^(?P<num>[0-9０-９]+)【(?P<title>.+?)】$",
      "parent_level": 2,
      "description": "章の下位: 『１【主要な経営指標等の推移】』等（数字は全角/半角）。",
      "validation_rules": {
        "max_length": 120,
        "must_contain": null,
        "must_not_contain": [
          "…"
        ],
        "must_not_end_with": [
          "。"
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "exclude_lines": null,
        "prev_line_regex": null,
        "next_line_regex": null,
        "only_after_first_match_of": null,
        "context_filters": null
      }
    },
    {
      "level": 4,
      "name": "Subsection_ParenNumber",
      "regex": "^\\((?P<num>[0-9]+)\\)\\s*(?P<title>[^0-9].+)$",
      "parent_level": 3,
      "description": "小見出し: 『(1) 連結経営指標等』等。電話番号等の誤検知を避けるため、括弧後が数字以外で始まることを要求。",
      "validation_rules": {
        "max_length": 120,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。"
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "exclude_lines": null,
        "prev_line_regex": null,
        "next_line_regex": null,
        "only_after_first_match_of": null,
        "context_filters": null
      }
    },
    {
      "level": 5,
      "name": "Item_CircledNumber",
      "regex": "^(?P<mark>[①-⑳])\\s*(?P<title>.+)$",
      "parent_level": 4,
      "description": "丸数字による項目（見出し/表内ラベル両方ありうる）。単独の '①' 等を避けるためタイトル必須。",
      "validation_rules": {
        "max_length": 120,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。"
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "exclude_lines": null,
        "prev_line_regex": "^$",
        "next_line_regex": null,
        "only_after_first_match_of": null,
        "context_filters": null
      }
    },
    {
      "level": 5,
      "name": "Item_Kana_Single",
      "regex": "^(?P<mark>[アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン])\\s*$",
      "parent_level": 4,
      "description": "カタカナ単独1文字の号建て（例: 'イ'）。前行が空行で、次行が非空のときのみ見出し候補とする。",
      "validation_rules": {
        "max_length": 4,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": null,
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "exclude_lines": null,
        "prev_line_regex": "^$",
        "next_line_regex": "^\\S",
        "only_after_first_match_of": null,
        "context_filters": null
      }
    },
    {
      "level": 5,
      "name": "Item_Kana_WithTitle",
      "regex": "^(?P<mark>[アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン])[\\s　]+(?P<title>\\S.{1,})$",
      "parent_level": 4,
      "description": "カタカナ号 + タイトル（例: 'ロ 規律ある運営'）。号の直後に空白（全角/半角）を必須とし、前行が空行であることを要求する。",
      "validation_rules": {
        "max_length": 80,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。"
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "exclude_lines": null,
        "prev_line_regex": "^$",
        "next_line_regex": null,
        "only_after_first_match_of": null,
        "context_filters": null
      }
    },
    {
      "level": 0,
      "name": "BracketHeading_Meta",
      "regex": "^【(?P<title>.+?)】$",
      "parent_level": null,
      "description": "括弧見出し（メタ/フォーム項目に多い）: 『【表紙】』『【提出書類】』等。前行が空行のときのみメタ見出し候補とする。",
      "validation_rules": {
        "max_length": 80,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。"
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "exclude_lines": null,
        "prev_line_regex": "^$",
        "next_line_regex": null,
        "only_after_first_match_of": null,
        "context_filters": null
      }
    },
    {
      "level": 0,
      "name": "PageMarker",
      "regex": "^―\\s*(?P<num>[0-9]+)\\s*―$",
      "parent_level": null,
      "description": "ページ区切り（『― 68 ―』等）。AST上はメタ。必要なら段落分割に利用。",
      "validation_rules": {
        "max_length": 20,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": null,
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "exclude_lines": null,
        "prev_line_regex": null,
        "next_line_regex": null,
        "only_after_first_match_of": null,
        "context_filters": null
      }
    }
  ],
  "global_exclusion_rules": {
    "toc_dots_lines": {
      "regex": "^\\S.+…{2,}\\s*[0-9０-９]+$",
      "description": "目次のドットリーダ行（行末がページ番号）を見出し抽出から除外。"
    },
    "pure_number_line": {
      "regex": "^[0-9０-９]+$",
      "description": "単独の数字行（ページ番号/表の数値）を見出しとして扱わない。"
    },
    "note_marker": {
      "regex": "^\\(注\\)\\s*[0-9０-９]+.*$",
      "description": "注記ラベルを見出し扱いしない。"
    },
    "phone_number": {
      "regex": "^(?:\\([0-9０-９]{2,4}\\)|[0-9０-９]{2,4}[－ー\\-])[0-9０-９－ー\\-\\s]+$",
      "description": "電話番号っぽい行（全角/半角、ハイフン/長音/空白含む）を見出し誤検知から除外。"
    }
  }
}