{
  "hierarchy_structure": [
    {
      "level": 0,
      "name": "Document_Title",
      "regex": "(?m)^(?!【)(?!■)(?!\\s*(?:作成日|ページ|バージョン)\\s*:)(?!\\s*\\d+\\s*/\\s*\\d+\\s*$)\\S.+$",
      "parent_level": null,
      "description": "文書タイトル（冒頭1行目想定）。他の見出し記法（【】/■）やメタ行を除外して、非空行を拾う。タイトル専用にするため冒頭行に限定する。",
      "validation_rules": {
        "max_length": 80,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。",
          "."
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": 1,
        "max_line": 1,
        "prev_line_regex": null,
        "next_line_regex": null,
        "only_after_first_match_of": null,
        "context_filters": null
      }
    },
    {
      "level": 1,
      "name": "Bracket_Section",
      "regex": "(?m)^【[^】]+】\\s*$",
      "parent_level": null,
      "description": "【目的】などの角括弧見出し。本文中の参照を避けるため『行全体が見出しのみ』の形に限定。",
      "validation_rules": {
        "max_length": 60,
        "must_contain": null,
        "must_not_contain": [
          "http://",
          "https://"
        ],
        "must_not_end_with": null,
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "prev_line_regex": null,
        "next_line_regex": null,
        "only_after_first_match_of": null,
        "context_filters": null
      }
    },
    {
      "level": 2,
      "name": "SquareBullet_Subsection",
      "regex": "(?m)^■\\s+\\S.+$",
      "parent_level": 1,
      "description": "■ データ取得フェーズ などの中見出し。基本的に直前に【】見出しが出現した後（Level1配下）として扱う。",
      "validation_rules": {
        "max_length": 80,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。",
          ".",
          "：",
          ":"
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "prev_line_regex": null,
        "next_line_regex": null,
        "only_after_first_match_of": "level:1",
        "context_filters": null
      }
    }
  ],
  "global_exclusion_rules": {
    "Meta_Header_Lines": {
      "regex": "(?m)^\\s*(?:作成日|ページ|バージョン)\\s*:\\s*.+$",
      "description": "冒頭のメタ情報行（見出しではない）"
    },
    "Footer_Page_X_of_Y": {
      "regex": "(?m)^\\s*\\d+\\s*/\\s*\\d+\\s*$",
      "description": "フッタ等のページ数表記（例: 15 / 15）"
    },
    "List_Items": {
      "regex": "(?m)^\\s*[\\-・]\\s+.+$",
      "description": "箇条書き（見出しではない）"
    }
  }
}