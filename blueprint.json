{
  "hierarchy_structure": [
    {
      "level": 1,
      "name": "Part",
      "regex": "(?m)^第[一二三四五六七八九十0-9]+部【[^】]+】\\s*$",
      "parent_level": null,
      "description": "最上位の部（例: 第1部【企業情報】）。EDINETのページヘッダより下に現れる。",
      "validation_rules": {
        "max_length": 60,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。",
          "."
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "prev_line_regex": "^$",
        "next_line_regex": null,
        "only_after_first_match_of": null,
        "context_filters": null
      }
    },
    {
      "level": 2,
      "name": "Chapter",
      "regex": "(?m)^第[０-９0-9]+【[^】]+】\\s*$",
      "parent_level": 1,
      "description": "部の中の章（例: 第１【企業の概況】）。全角/半角数字の両方に対応。",
      "validation_rules": {
        "max_length": 60,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。",
          "."
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "prev_line_regex": "^$",
        "next_line_regex": null,
        "only_after_first_match_of": "level:1",
        "context_filters": null
      }
    },
    {
      "level": 3,
      "name": "Section_Numbered_Brackets",
      "regex": "(?m)^[０-９0-9]+【[^】]+】\\s*$",
      "parent_level": 2,
      "description": "章内の番号付きセクション（例: １【主要な経営指標等の推移】）。",
      "validation_rules": {
        "max_length": 80,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。",
          "."
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "prev_line_regex": "^$",
        "next_line_regex": null,
        "only_after_first_match_of": "level:2",
        "context_filters": null
      }
    },
    {
      "level": 4,
      "name": "Subsection_ParenNumber_Brackets",
      "regex": "(?m)^（[０-９0-9]+）【[^】]+】\\s*$",
      "parent_level": 3,
      "description": "丸括弧番号＋【】の小見出し（例: （１）【株式の総数等】）。",
      "validation_rules": {
        "max_length": 80,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。",
          "."
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "prev_line_regex": "^$",
        "next_line_regex": null,
        "only_after_first_match_of": "level:3",
        "context_filters": null
      }
    },
    {
      "level": 5,
      "name": "Subsubsection_CircledNumber_Brackets",
      "regex": "(?m)^[\\u2460-\\u2473]【[^】]+】\\s*$",
      "parent_level": 4,
      "description": "丸数字（①〜⑳程度）＋【】（例: ①【株式の総数】）。",
      "validation_rules": {
        "max_length": 80,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。",
          "."
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "prev_line_regex": "^$",
        "next_line_regex": null,
        "only_after_first_match_of": "level:4",
        "context_filters": null
      }
    },
    {
      "level": 4,
      "name": "ListItem_ParenNumber_Text",
      "regex": "(?m)^\\([0-9]+\\)\\s+\\S.+$",
      "parent_level": 3,
      "description": "半角の(1)〜形式の見出し（例: (1) 連結経営指標等）。本文中の参照と衝突しやすいので文脈条件を強めにする。",
      "validation_rules": {
        "max_length": 80,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。",
          "."
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "prev_line_regex": "^$",
        "next_line_regex": null,
        "only_after_first_match_of": "level:3",
        "context_filters": null
      }
    },
    {
      "level": 3,
      "name": "Section_Arabic_Brackets_WithOptionalPrefix",
      "regex": "(?m)^(?:[０-９0-9]+)?\\s*【[^】]+】\\s*$",
      "parent_level": 2,
      "description": "番号が付かない/付いても揺れる【】見出し（例: 【注記事項】、【株式の種類等】など）。誤検知回避のためアンカー後のみ有効＆短い行に限定。",
      "validation_rules": {
        "max_length": 50,
        "must_contain": null,
        "must_not_contain": null,
        "must_not_end_with": [
          "。",
          "."
        ],
        "requires_line_start": true,
        "requires_prev_empty_line": null,
        "min_line": null,
        "max_line": null,
        "prev_line_regex": "^$",
        "next_line_regex": null,
        "only_after_first_match_of": "level:2",
        "context_filters": null
      }
    },
    {
      "level": 2,
      "name": "Chapter_RomanPart",
      "regex": "(?m)^第[一二三四五六七八九十0-9]+部【[^】]+】\\s*$",
      "parent_level": 1,
      "description": "（Partと同じ見え方だが、後続処理でPartとして扱う。互換用に残す場合の定義）",
      "validation_rules": null
    }
  ],
  "global_exclusion_rules": {
    "page_header_edinet": {
      "regex": "^(?:EDINET提出書類|.+\\(E\\d{5}\\)|有価証券報告書)\\s*$",
      "description": "各ページのヘッダ（繰り返し）を除外"
    },
    "page_counter": {
      "regex": "^\\s*\\d{1,3}/225\\s*$",
      "description": "ページ番号（例:  51/225）を除外"
    },
    "note_line": {
      "regex": "^\\s*[（(]注[）)]\\s*",
      "description": "注記行は見出し抽出から除外（見出しと誤認しやすい）"
    }
  }
}
